# Desenvolvimento local. Escolha a mesma senha nas duas configurações abaixo.
APP_ENV=development
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://smartmall:CHANGE_ME@localhost:5432/smartmall
# Testes criam e removem um banco isolado; este usuário precisa de CREATEDB.
TEST_DATABASE_URL=postgresql+psycopg://smartmall:CHANGE_ME@localhost:5432/smartmall
CORS_ORIGINS=http://localhost:5173
# A chave fica somente no backend. Simulação não chama o provedor.
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_SIMULATION=false
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=20
# Deploy de demonstração: APP_ENV=demo exige simulação e código privado forte.
# Não coloque este código em variáveis VITE_, commits ou URLs.
DEMO_ACCESS_TOKEN=
DEMO_SEED=false
